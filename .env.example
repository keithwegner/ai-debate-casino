# Copy to .env and fill this in. ChatGPT subscription billing and API billing are separate.
# The server treats this placeholder as mock mode until you replace it.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Default model for all tasks unless task-specific variables below are set.
OPENAI_MODEL=gpt-5.5

# Optional task-specific routing. Good hackathon defaults:
OPENAI_MODEL_SETUP=gpt-5.5
OPENAI_MODEL_DEBATE=gpt-5.5
OPENAI_MODEL_JUDGE=gpt-5.5

# Optional: use a higher-compute judge. Slower and more expensive.
# OPENAI_MODEL_JUDGE=gpt-5.5-pro

# Reasoning effort: none, low, medium, high, xhigh.
OPENAI_REASONING_EFFORT=xhigh
OPENAI_REASONING_SETUP=xhigh
OPENAI_REASONING_DEBATE=xhigh
OPENAI_REASONING_JUDGE=xhigh

# Use fast for a shorter live demo, full for all debate phases.
DEBATE_SCRIPT=fast

PORT=8787
OPENAI_TIMEOUT_MS=90000

# Test without token usage.
# MOCK_AI=true
